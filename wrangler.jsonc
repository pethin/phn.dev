{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "phn-dev",
	"compatibility_date": "2026-06-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"send_metrics": false,
	"placement": {
		"mode": "smart"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}